# mactelnet-proxy — environment overrides
#
# Copy to /etc/default/mactelnet-proxy (Debian/Ubuntu) or
# /etc/sysconfig/mactelnet-proxy (RHEL/Fedora) and edit. The unit
# file picks either path automatically.
#
# Lines are KEY=VALUE; no `export` keyword. The proxy binary reads
# each of these via os.Getenv() at startup; CLI flags (if anyone
# overrides ExecStart) win, env vars come next, built-in defaults
# last. Leave entries commented to keep the defaults.

# Address:port the embedded SSH server binds to. Avoid 22 unless
# you've already moved the system sshd somewhere else.
#MACTELNET_PROXY_LISTEN=0.0.0.0:222

# Directory holding the SSH host key and authorized_keys. Both are
# auto-generated on first run; the binary creates the directory if
# missing.
#MACTELNET_PROXY_KEYS_DIR=/etc/mactelnet-proxy

# L2-facing interface for mactelnet/mndp. REQUIRED for actual
# mac-telnet/mndp traffic to work — the binary will start without
# it but every SSH exec returns code 2 with a usage error. Pick the
# interface that's on the same broadcast domain as the MikroTik
# devices you want to reach (typically a VLAN sub-interface, e.g.
# bond0.20 or eth0).
#MACTELNET_PROXY_INTERFACE=eth1

# Total retransmit budget for the pre-END_AUTH MAC-Telnet handshake.
# Empty = binary default (~10s). Bump to 30s on flaky links or busy
# MikroTik CPUs.
#MACTELNET_PROXY_AUTH_TIMEOUT=10s

# Total retransmit budget for in-session DATA packets. Empty =
# upstream default (~2.4s). Bump cautiously — too high makes a
# dropped keystroke visibly stall the terminal session.
#MACTELNET_PROXY_DATA_TIMEOUT=

# Set to any non-empty value (except 0/false/no/off) to enable
# verbose packet-level logging. Useful while diagnosing a failed
# session; off in production.
#MACTELNET_PROXY_DEBUG=1

# Less commonly overridden — both default to <KEYS_DIR>/<filename>
# if blank. Set explicitly only if your host key or authorized_keys
# live somewhere other than KEYS_DIR.
#MACTELNET_PROXY_HOST_KEY=/etc/mactelnet-proxy/mactel_ed25519_key
#MACTELNET_PROXY_AUTHORIZED_KEYS=/etc/mactelnet-proxy/authorized_keys
